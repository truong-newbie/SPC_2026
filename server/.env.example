# SPC_2026 Server Environment Variables

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:3000
TRUSTED_PROXY_COUNT=0

# Connection Limits
MAX_CONNECTIONS_PER_IP=30
MAX_TURN_REQUESTS_PER_IP=20
MAX_CODE_REQUESTS_PER_IP=60
MAX_ACTIVE_CODES=10000

# Cloudflare TURN (optional - for production)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Coturn (optional - self-hosted relay)
TURN_SECRET=
TURN_DOMAIN=

# Stats Persistence (optional - Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAX_REPORT_BYTES=576460752303423487
